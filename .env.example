# Settings for "docker compose up --build". Copy this file to ".env" (which Git ignores) and fill it in:
#   cp .env.example .env
# Never commit the real .env file. In the CI pipeline these values come from throw-away generated
# secrets, not from this file.

# Secret used to sign login tokens (at least 32 characters). Make one with:   openssl rand -hex 32
JWT_SECRET=

# Password for the MongoDB root user created by the container. Keep it URL-safe (hex). Make one with:
#   openssl rand -hex 24
# MongoDB now requires authentication and is no longer published to the host. If you started an older
# version of this stack, run "docker compose down -v" once so MongoDB is re-created with this password.
MONGO_PASSWORD=

# Own security feature: account lockout after this many failed sign-ins, for this many minutes.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Cloud logging (Azure Application Insights, the submitted provider). Copy the full "Connection string"
# from the Azure resource Overview page. Leave empty to log only to the local file and container output.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional generic HTTPS JSON log ingest (not used by the submitted deployment). Both values are needed.
LOG_CLOUD_URL=
LOG_CLOUD_TOKEN=
