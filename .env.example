# Settings for "docker compose up --build". Copy this file to ".env" (which Git ignores) and fill it in:
#   cp .env.example .env
# Never commit the real .env file.

# Secret used to sign login tokens. Make one with:   openssl rand -hex 32
JWT_SECRET=

# Password for the MongoDB container. Keep it URL-safe (hex). Make one with:   openssl rand -hex 24
# Existing MongoDB volumes keep their users/passwords. Preserve the old data and credentials.
# For a separate fresh verification database, use: docker compose -p hustlehub-poe-check up --build -d --wait
# Do not delete the existing data volume to fix authentication; back up and migrate it deliberately.
MONGO_PASSWORD=

# Optional: account lockout settings
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Optional: ship structured logs to a cloud log platform (Better Stack Logs).
# LOG_CLOUD_URL is the https:// ingesting host URL shown for your Better Stack source.
LOG_CLOUD_URL=
LOG_CLOUD_TOKEN=

# Optional Azure Application Insights (takes precedence over the two settings above).
# Copy the full Connection string from the Azure resource Overview. Never commit the real value.
APPLICATIONINSIGHTS_CONNECTION_STRING=
