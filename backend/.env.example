# Server
PORT=5443
NODE_ENV=development

# JWT
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1h

# HTTPS certificate paths (self-signed, local dev only)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# bcrypt
BCRYPT_SALT_ROUNDS=12

# --- Part 2 additions ---

# MongoDB is required for every normal run. Memory storage is test-only.
# For Docker
# Compose, use: mongodb://mongo:27017/hustlehub
# For a local MongoDB install, use: mongodb://localhost:27017/hustlehub
# For MongoDB Atlas, use the connection string from your cluster.
MONGODB_URI=mongodb://localhost:27017/hustlehub

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Booking endpoint rate limiting (sensitive endpoint - POE requirement)
BOOKING_RATE_LIMIT_WINDOW_MS=900000
BOOKING_RATE_LIMIT_MAX=10

# false for direct local HTTPS; 1 only behind a controlled reverse proxy
TRUST_PROXY=false
