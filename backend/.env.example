# Server
PORT=5443
NODE_ENV=development

# JWT
JWT_SECRET=replace_this_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1h

# HTTPS certificate paths (local development CA + server certificate; made by "npm run gen-cert")
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# bcrypt
BCRYPT_SALT_ROUNDS=12

# --- Part 2 additions ---

# MongoDB is required for every normal run. Memory storage is test-only.
# For Docker
# Compose, use: mongodb://mongo:27017/hustlehub
# For a local MongoDB install, use: mongodb://localhost:27017/hustlehub
# For MongoDB Atlas, use the connection string from your cluster.
MONGODB_URI=mongodb://localhost:27017/hustlehub

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=https://localhost:5173,https://localhost:5443

# Booking endpoint rate limiting (sensitive endpoint - POE requirement)
BOOKING_RATE_LIMIT_WINDOW_MS=900000
BOOKING_RATE_LIMIT_MAX=10

# false for direct local HTTPS; 1 only behind a controlled reverse proxy
TRUST_PROXY=false

# --- Part 3 additions ---

# Account lockout: lock an account after this many failed sign-ins for this many minutes.
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Optional generic cloud log shipping to any HTTPS JSON ingest endpoint. The submitted deployment uses
# Azure Application Insights instead (next setting), which takes precedence over this one.
# Leave both empty to log to the local file and standard output only.
# LOG_CLOUD_URL is the ingest URL of your log service (it must start with https://).
LOG_CLOUD_URL=
LOG_CLOUD_TOKEN=

# Optional Azure Application Insights for direct npm start; takes precedence over HTTP shipping.
# For Docker, set this in the ROOT .env instead. Copy the full portal Connection string.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional: where the local event log is written (defaults to backend/logs).
# LOG_DIR=./logs
