{
  "name": "hustlehub-backend",
  "version": "3.0.0",
  "description": "HustleHub+ Final PoE - Secure full-stack MERN marketplace API with DevSecOps pipeline (INSY7314)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "gen-cert": "node scripts/generateCert.js",
    "trust-cert": "node scripts/trustCert.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "jest --watch",
    "test:api": "node scripts/runNewman.js",
    "lint": "eslint . --max-warnings 0",
    "lint:report": "eslint . --max-warnings 0 -f json -o test-results/eslint-report.json",
    "seed-admin": "node scripts/seedAdmin.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage"
  },
  "keywords": [
    "hustlehub",
    "express",
    "jwt",
    "mongodb",
    "mongoose",
    "security",
    "mern"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "newman": "^6.2.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  }
}
