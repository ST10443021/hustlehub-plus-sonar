# Secrets and local configuration (never commit real .env files or private keys)
.env
**/.env
.env.local
**/.env.local
# Keep the safe templates and the test settings tracked:
#   backend/.env.example, frontend/.env.example, backend/.env.test

# Dependencies and build output
node_modules/
**/node_modules/
**/dist/
**/build/
**/coverage/
**/test-results/

# Local HTTPS certificates and keys (made by "npm run gen-cert", per computer)
**/certs/*
!**/certs/.gitkeep
*.pem
*.key
*.csr
*.srl
*.p12
*.pfx

# Logs
**/logs/*.log
**/logs/*.log.*
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and operating system files
.vs/
.vscode/
.idea/
*.suo
*.user
*.sln.docstates
.DS_Store
Thumbs.db
desktop.ini
env
